# Copy to .env and fill in. .env is gitignored.
#
# You need ONE model endpoint that speaks the OpenAI chat-completions API.
# `verifiers` talks to everything through that interface, which is why the same
# environment code can evaluate a hosted model today and train a local one later.

# --- Option A: OpenAI ---------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4.1-mini

# --- Option B: any OpenAI-compatible provider ---------------------------------
# Most providers (including GMI Cloud's inference endpoints, Together, Fireworks,
# OpenRouter, or a vLLM server you start yourself) work by just pointing
# OPENAI_BASE_URL somewhere else and using their key. For example:
#
# OPENAI_API_KEY=<your gmi key>
# OPENAI_BASE_URL=https://api.gmi-serving.com/v1
# MODEL=Qwen/Qwen3-8B

# --- Prime Intellect ----------------------------------------------------------
# Not needed until Module 04 (publishing to the Environments Hub).
# `prime login` writes its own config, so this is usually optional.
PRIME_API_KEY=

# --- Optional: Weights & Biases for training curves in Module 05 --------------
WANDB_API_KEY=
